{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Comprexy": "Information"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "Comprexy": "Data Source=comprexy.db;Cache=Shared"
  },
  "Auth": {
    "RequiredApiKey": null
  },
  "Metrics": {
    "Enabled": true,
    "PromptTokenBasis": "ProviderActual"
  },
  "McpTelemetry": {
    "DefaultRowLimit": 100,
    "MaxRowLimit": 1000,
    "QueryTimeoutSeconds": 5
  }
}
