{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Comprexy": "Information"
    }
  },
  "AllowedHosts": "*",
    "ConnectionStrings": {
      "Comprexy": "Data Source=comprexy.db;Cache=Shared"
    },
  "Provider": {
    "Type": "OpenAICompatible",
    "BaseUrl": "http://localhost:11434/v1",
    "ApiKey": null,
    "Model": null,
    "TimeoutSeconds": 600
  },
  "Compression": {
    "BaseUrl": null,
    "ApiKey": null,
    "Model": null,
    "TimeoutSeconds": 600,
    "Temperature": 0.6,
    "EnableThinking": false,
    "InlineInstructionFile": "Prompts/compression-inline.md",
    "WorkingMemoryTemplateFile": "Prompts/working-memory-template.md"
  },
  "ContextPolicy": {
    "SoftLimitTokens": 32000,
    "MinTurnsBetweenGenerations": 6,
    "CompressionRetainMessageCount": 1,
    "DedupeDuplicateFailedEdits": true,
    "TokenizerEncoding": "cl100k_base"
  },
  "Auth": {
    "RequiredApiKey": null
  },
  "Proxy": {
    "PassThrough": false,
    "StripReasoningContent": false
  },
  "CacheAlignment": {
    "Enabled": true,
    "MaxConversations": 1024
  },
  "Metrics": {
    "Enabled": true,
    "PromptTokenBasis": "ProviderActual"
  },
  "ToolSchema": {
    "Mode": "Virtual",
    "MappingMaxRetries": 2,
    "MaxRangeLines": 250,
    "MaxSearchMatches": 40,
    "MaxDirListEntries": 200,
    "MaxShellObservationChars": 4000,
    "ExcludeFromModelTools": [
      "ReadLints",
      "TodoWrite",
      "AwaitShell",
      "UpdateCurrentStep",
      "EditNotebook",
      "SwitchMode",
      "agent_manager",
      "agent_manager_models",
      "background_process",
      "kilo_local_recall"
    ],
    "FileCacheAbsoluteExpiration": "00:20:00",
    "FileCacheSizeLimit": 256,
    "CallIdMapPendingAbsoluteExpiration": "00:30:00",
    "CallIdMapMaxConversations": 1024
  },
  "Trace": {
    "ClientInput": false,
    "ClientOutput": false,
    "ModelInput": false,
    "ModelOutput": false,
    "CompressionModelInput": false,
    "CompressionModelOutput": false,
    "ContextBudget": false,
    "RequestFiles": false,
    "RequestLogDirectory": "logs/requests",
    "MaxPayloadChars": 32768
  },
  "Comprexy": {
    "TokenEstimateCache": {
      "AbsoluteExpiration": "00:15:00",
      "SizeLimit": 10000
    }
  }
}
