{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/apps/proxy/Comprexy.Api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-control-api",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/apps/control-api/Comprexy.ControlApi.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/apps/proxy/Comprexy.Api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/apps/proxy/Comprexy.Api.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dashboard:dev",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/apps/dashboard"
            },
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "dashboard:build",
            "type": "shell",
            "command": "npm run build",
            "options": {
                "cwd": "${workspaceFolder}/apps/dashboard"
            },
            "problemMatcher": []
        },
        {
            "label": "dashboard:test",
            "type": "shell",
            "command": "npm test",
            "options": {
                "cwd": "${workspaceFolder}/apps/dashboard"
            },
            "problemMatcher": []
        },
        {
            "label": "dashboard:test:e2e",
            "type": "shell",
            "command": "npm run test:e2e",
            "options": {
                "cwd": "${workspaceFolder}/apps/dashboard"
            },
            "problemMatcher": []
        }
    ]
}
